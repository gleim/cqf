  "freqai": {
    "enabled": true,
    "model_save_type": "stable",
    "freqaimodel": "SVRSurfModel",
    "freqaimodel_path": "user_data/versions/v1.27/freqaimodels/",
    "purge_old_models": 3,
    "train_period_days": 7,
    "backtest_period_days": 1,
    "live_retrain_hours": 1,
    "expiration_hours": 2,
    "identifier": "surf_v1_27_svm_rbf",
    "continual_learning": true,
    "write_metrics_to_disk": true,
    "feature_parameters": {
      "include_timeframes": ["1m", "5m", "15m"],
      "include_corr_pairlist": [
        "BTC/USDC:USDC"
      ],
      "label_period_candles": 12,
      "include_shifted_candles": 2,
      "DI_threshold": 1.0,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": true,
      "svm_params": {
        "shuffle": false,
        "nu": 0.1
