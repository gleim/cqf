      "use_DBSCAN_to_remove_outliers": false,
      "indicator_periods_candles": [5, 10, 20, 50],
      "plot_feature_importances": 10
    },
    "data_split_parameters": {
      "test_size": 0.25,
      "shuffle": false
    },
    "model_training_parameters": {
      "C": 1.0,
      "gamma": "scale",
      "epsilon": 0.1
    },
    "rl_config": {
      "drop_ohlc_from_features": false,
      "train_cycles": 25,
      "add_state_info": true,
      "max_trade_duration_candles": 300,
      "model_reward_parameters": {
        "rr": 1.0,
        "profit_aim": 0.025
      }
    }
  },
  
  "telegram": {
    "enabled": false,
